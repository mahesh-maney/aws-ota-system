# ─────────────────────────────────────────────────────────────────────────────
# Digilux OTA — environment configuration
# Source this file in deploy scripts: source infrastructure/ota.env
# These values are injected as Lambda environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# Pre-signed URL expiry tiers (based on artifact size)
# Tier 1: small packages  (< TIER1_MAX_MB)
# Tier 2: medium packages (TIER1_MAX_MB – TIER2_MAX_MB)
# Tier 3: large packages  (TIER2_MAX_MB – TIER3_MAX_MB)
# Tier 4: very large      (> TIER3_MAX_MB)

PRESIGN_EXPIRY_TIER1_MAX_MB=50
PRESIGN_EXPIRY_TIER1_SEC=3600       # 1 hour

PRESIGN_EXPIRY_TIER2_MAX_MB=200
PRESIGN_EXPIRY_TIER2_SEC=21600      # 6 hours

PRESIGN_EXPIRY_TIER3_MAX_MB=500
PRESIGN_EXPIRY_TIER3_SEC=86400      # 24 hours

PRESIGN_EXPIRY_TIER4_SEC=172800     # 48 hours  (> 500MB)

# IoT Job in-progress timeout (minutes)
IOT_JOB_TIMEOUT_MINUTES=1440        # 24 hours

# CloudFront distribution for S3 artifact delivery
# Set after running: bash infrastructure/14_cloudfront_setup.sh
CLOUDFRONT_DOMAIN=d2lr14tk4wqz8z.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=K3CL07APICBEMS
CLOUDFRONT_PRIVATE_KEY_SECRET=digilux-ota-cloudfront-key
