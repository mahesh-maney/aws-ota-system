# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Lambda dependency packages (rebuilt during deployment)
infrastructure/06_lambdas/*/package/

# Claude Code settings
.claude/

# macOS
.DS_Store

# Test artifacts (contain tokens and URLs — never commit)
/tmp/ota_*.txt
/tmp/ota_test.sh

# Generated test artefacts (large binaries — rebuild with infrastructure/make_test_artifact.py)
test-artifacts/

# Environment / secrets
.env
*.env
secrets.json
credentials.json

# CDK synthesized output (generated, never commit)
cdk/cdk.out/
cdk/outputs-*.json

# CDK test configs (contain real account IDs)
cdk/config/digilux-test.json

# Zero-touch deploy config (contains account IDs, authorizer IDs — customer-specific)
infrastructure/deploy.config

# Lambda zip artifacts created during deploy (rebuilt by 07_deploy_lambdas.sh)
infrastructure/06_lambdas/**/*.zip
